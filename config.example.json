{
  "documents": "documents",
  "embedding": {
    "type": "voyage",
    "model": "voyage-4-lite",
    "dimensions": 1024,
    "baseUrl": "https://api.voyageai.com/v1",
    "apiKeyEnv": "VOYAGE_API_KEY"
  },
  "reranker": {
    "type": "none",
    "model": "none"
  },
  "chunking": {
    "mode": "semantic",
    "legacyTarget": 180,
    "legacyMax": 240,
    "legacyOverlap": 30,
    "semanticMin": 120,
    "semanticTarget": 280,
    "semanticMax": 420,
    "semanticUnitMax": 140
  },
  "alpha": 0.3,
  "topK": 5,
  "candidateTopK": 30,
  "httpTimeoutMs": 30000,
  "httpMaxRetries": 3,
  "indexing": {
    "workers": 32,
    "semanticWorkers": 2,
    "embeddingWorkers": 4,
    "embeddingBatchSize": 64
  }
}
